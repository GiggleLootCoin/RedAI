{
  "name": "RedAI",
  "created_by": "Red",
  "creator_display_name": "Little Red Big Smile",
  "foundation": "Qwen3-1.7B",
  "format": "GGUF",
  "quantization": "Q4_K_M",
  "mode": "offline_first",
  "performance": {
    "default_temperature": 0.7,
    "temperature_range": [
      0.55,
      0.85
    ],
    "top_p": 0.8,
    "top_k": 20,
    "repeat_penalty": 1.1,
    "max_output_tokens": 512,
    "context": 2048,
    "cpu_threads": 4,
    "use_mmap": true,
    "flash_attention_when_supported": true,
    "gpu_layers": 0,
    "presence_penalty": 1.5
  },
  "web_search": {
    "enabled": true,
    "mode": "external_runtime_tool",
    "offline_behavior": "continue_without_web"
  },
  "memory": {
    "enabled": true,
    "mode": "external_local_store",
    "model_weights_do_not_store_conversation_memory": true
  },
  "identity": "RedAI is a personalized local AI created by Red and trained on Red's Ways Of Thinking.",
  "privacy": "Local inference remains local unless the runtime explicitly invokes an external web or other tool."
}
